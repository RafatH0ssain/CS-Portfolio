---
import '../styles/blueprint.css';
import Masthead from '../components/Masthead.astro';

interface Props {
  title: string;
  description: string;
  /** Shown in the masthead, unused on the home page. */
  current?: string;
}

const { title, description, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="theme-color" content="#0F2350">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="canonical" href={canonical.href}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical.href}>
    <meta property="og:type" content="website">
    <link rel="preload" href="/fonts/anybody-latin.woff2" as="font" type="font/woff2" crossorigin>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="sheet">
      <div class="zones zones--top" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span></div>
      <div class="zones zones--left" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span><span>G</span><span>H</span></div>

      <div class="drawing">
        <Masthead current={current} />
        <main id="main">
          <slot />
        </main>
      </div>

      <div class="zones zones--right" aria-hidden="true"><span>A</span><span>B</span><span>C</span><span>D</span><span>E</span><span>F</span><span>G</span><span>H</span></div>
      <div class="zones zones--bottom" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span></div>
    </div>
  </body>
</html>
