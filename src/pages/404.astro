---
import Sheet from '../layouts/Sheet.astro';
import { profile } from '../lib/content';

const fullName = `${profile.name.first} ${profile.name.last}`;
---

<Sheet title={`Page not found — ${fullName}`} description={`That page does not exist on ${fullName}'s portfolio. Head back to the home page.`}>
  <section class="section solid" aria-labelledby="nf-h">
    <div class="section__head">
      <div class="section__title">
        <h1 id="nf-h" class="t-sheet">Page not found</h1>
      </div>
    </div>
    <p class="t-lead">That page does not exist.</p>
    <div class="btn-row btn-row--spaced">
      <a class="btn btn--outline" href="/">Back to home</a>
    </div>
  </section>
</Sheet>