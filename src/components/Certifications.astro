---
import { certifications } from '../lib/content';
import SheetFoot from './SheetFoot.astro';
---

{ certifications && (
  <section class="section" id="certifications" aria-labelledby="cert-h">
    <div class="section__head">
      <div class="section__title">
        <h2 id="cert-h" class="t-sheet">Certifications</h2>
      </div>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th scope="col" class="w-70">No.</th>
          <th scope="col">Certification</th>
          <th scope="col" class="w-220">Issuer</th>
          <th scope="col" class="w-90">Year</th>
        </tr>
      </thead>
      <tbody>
        {certifications.map((c, i) => (
          <tr>
            <td class="num">C{i + 1}</td>
            <td>
              <div class="desc">
                <span class="strong">{c.title}</span>
                {c.credentialId && <span class="t-dim">Credential {c.credentialId}</span>}
              </div>
            </td>
            <td>{c.issuer}</td>
            <td class="num">{c.year}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <SheetFoot />
  </section>
)}