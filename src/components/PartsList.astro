---
import type { CollectionEntry } from 'astro:content';
import { revisions } from '../lib/content';
import { currentStop, numberedProjects, stateClass } from '../lib/derive';
import SheetFoot from './SheetFoot.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
const stop = currentStop(revisions);
const rows = numberedProjects(projects);
---

<section class="section" id="projects-list" aria-labelledby="all-h">
  <div class="section__head">
    <div class="section__title">
      <h2 id="all-h" class="t-sheet">All projects</h2>
    </div>
    <p class="section__intro">Every project, not only the featured ones. Rows dim for anything not yet started at the point in the timeline you pick.</p>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th scope="col" class="w-70">No.</th>
        <th scope="col">Project</th>
        <th scope="col" class="w-120">Version</th>
        <th scope="col" class="w-300">Stack</th>
        <th scope="col" class="w-140">Type</th>
        <th scope="col" class="w-160">Status</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((p) => (
        <tr data-release data-lvl={p.data.level} class:list={[stateClass(p.data.level, stop)]}>
          <td class="num">{p.partNo}</td>
          <td><a class="strong" href={`/parts/${p.id}/`}>{p.data.title}</a></td>
          <td class="num">{p.data.version}</td>
          <td>{p.data.stack.join(', ')}</td>
          <td>{p.data.kind}</td>
          <td class="st">
            <span class="st-released">{p.data.status}</span>
            <span class="st-new">New</span>
            <span class="st-future">Planned</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <SheetFoot />
</section>