---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Schematic from './Schematic.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;
const callouts = d.figure.callouts;

const links = [
  { key: 'live', label: 'Live site' },
  { key: 'repo', label: 'Source code' },
  { key: 'writeup', label: 'Write-up' },
] as const;

const W = 820;
const H = 480;
const BALLOON = 28;

// Leader goes 40px up, and to the left unless the callout is hard against the
// left edge, in which case it goes right.
const geometry = callouts.map((c) => {
  const x = c.x * W;
  const y = c.y * H;
  const leftward = c.x >= 0.1;
  const bx = leftward ? x - 40 : x + 40;
  const by = y - 40;
  return { x, y, bx, by, leftward };
});
---

<section class="section" aria-label="Figure 3.1">
  <div class="fig31">
    <figure class="stack stack--fig">
      <div class="fig31__frame">
        {d.figure.image ? (
          <Picture
            src={d.figure.image}
            alt={d.figure.alt ?? ''}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={960}
            widths={[480, 960]}
            quality={70}
          />
        ) : (
          <Schematic name={d.figure.schematic} size="sheet" />
        )}
        <svg class="fig31__overlay" viewBox={`0 0 ${W} ${H}`} aria-hidden="true" preserveAspectRatio="none">
          {geometry.map((g, i) => (
            <g>
              <circle class="fig31__dot" cx={g.x} cy={g.y} r="3.5"/>
              <line class="fig31__leader" x1={g.x} y1={g.y} x2={g.bx} y2={g.by}/>
              <circle class="fig31__balloon" cx={g.bx} cy={g.by} r={BALLOON / 2}/>
              <text class="fig31__num" x={g.bx} y={g.by + 5} text-anchor="middle">{i + 1}</text>
            </g>
          ))}
        </svg>
      </div>
      <figcaption class="figcaption-row">
        <span class="label">Fig. 3.1 — {d.plateTitle ?? d.title}</span>
        <span class="label">{d.figure.image ? 'Screenshot' : 'Schematic, not to scale'}</span>
      </figcaption>
    </figure>

    <div>
      <ol class="legend">
        {callouts.map((c, i) => (
          <li>
            <span class="balloon">{i + 1}</span>
            <div class="legend__text">
              <span class="t-part-note">{c.title}</span>
              <span class="t-body t-dim">{c.note}</span>
            </div>
          </li>
        ))}
      </ol>

      {links.some((l) => d.links[l.key]) && (
        <div class="stack stack--links">
          <span class="label">Inspect it yourself</span>
          <div class="btn-row">
            {links
              .filter((l) => d.links[l.key])
              .map((l) => (
                <a
                  class:list={['btn', l.key === 'live' ? 'btn--primary' : 'btn--outline']}
                  href={d.links[l.key]}
                  rel="noopener"
                >{l.label}</a>
              ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
