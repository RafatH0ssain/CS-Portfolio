---
import { profile } from '../lib/content';

interface Props {
  /** Only the last foot on a page carries the copyright line. */
  copyright?: boolean;
}

const { copyright = false } = Astro.props;
const line = `(c) ${profile.updated.slice(0, 4)} ${profile.name.first} ${profile.name.last}`;
---

<div class="sheet-foot">
  {copyright && <span class="label">{line}</span>}
</div>