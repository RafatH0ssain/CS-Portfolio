---
import { profile } from '../lib/content';
---

<div class="gen-notes">
  <span class="label">General notes — the short version</span>
  <ol>
    {profile.shortVersion.map((note, i) => (
      <li>
        <span class="gnotes__n">{i + 1}.</span>
        <p><strong>{note.lead}</strong> {note.rest}</p>
      </li>
    ))}
  </ol>
  <p class="gen-notes__aside">Drawings are a design choice; this is my portfolio.</p>
</div>
