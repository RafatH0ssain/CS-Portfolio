---
import { academics } from '../lib/content';
---

<div class="inspect">
  <div class="inspect__head">
    <span class="label label--amber">Inspection report</span>
    <span class="label">Shown on request</span>
  </div>
  <div class="inspect__grid">
    {academics?.standing && (
      <div class="tblock__cell"><span class="label">Standing</span><span class="tblock__value">{academics.standing}</span></div>
    )}
    {academics?.gpa && (
      <div class="tblock__cell"><span class="label">GPA</span><span class="tblock__value">{academics.gpa}</span></div>
    )}
    {academics?.awards && academics.awards.length > 0 && (
      <div class="tblock__cell">
        <span class="label">Awards</span>
        <span class="tblock__value">{academics.awards.join('; ')}</span>
      </div>
    )}
  </div>
</div>
