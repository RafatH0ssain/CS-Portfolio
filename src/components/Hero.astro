---
import { academics, profile } from '../lib/content';
import { nameChars, stopText, type Stop } from '../lib/derive';
import Fig1 from './Fig1.astro';
import Inspection from './Inspection.astro';
import SheetFoot from './SheetFoot.astro';

interface Props {
  stop: Stop;
  projectCount: number;
}

const { stop, projectCount } = Astro.props;
const { head, bio } = stopText(stop, profile);
const chars = nameChars(profile);
const gradYear = profile.shipsOn.split(' ')[1];
---

<section class="hero" aria-labelledby="name">
  <div class="hero__grid">
    <div class="hero__intro">
      <div class="name-box">
        <h1 id="name" class="name" style={`--chars:${chars}`}>
          <span>{profile.name.first}</span>
          <span>{profile.name.last}</span>
        </h1>
      </div>
      <p class="hero__status">Class of {gradYear}, open to {profile.openTo.toLowerCase()}</p>
      <div class="hero__copy">
        <p class="t-head" data-rev-field="head">{head}</p>
        <p class="hero__bio" data-rev-field="bio">{bio}</p>
      </div>
      {academics?.show === true && <Inspection />}
      <div class="btn-row">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>Email me</a>
        <a class="btn btn--outline" href={profile.links.resume}>Résumé (PDF)</a>
      </div>
    </div>

    <div class="fig-box">
      <Fig1 stop={stop} projectCount={projectCount} />
    </div>
  </div>

  <slot name="projects" />

  <div class="stack stack--glance">
    <span class="label">At a glance</span>
    <div class="tblock tblock--2">
      <div class="tblock__cell"><span class="label">Program</span><span class="tblock__value">{profile.program}</span></div>
      <div class="tblock__cell"><span class="label">Graduating</span><span class="tblock__value">{profile.shipsOn}</span></div>
      {profile.location && <div class="tblock__cell"><span class="label">Based in</span><span class="tblock__value">{profile.location}</span></div>}
      {profile.workAuth && <div class="tblock__cell"><span class="label">Work authorization</span><span class="tblock__value">{profile.workAuth}</span></div>}
    </div>
  </div>

  <slot name="notes" />

  <SheetFoot />
</section>