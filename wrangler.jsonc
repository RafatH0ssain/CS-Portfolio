// Cloudflare Workers, static assets only (no server code).
// The owner deploys; the agent never runs `wrangler deploy` or `wrangler login`.
{
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "work.rafathossain.com", "custom_domain": true }]
}
