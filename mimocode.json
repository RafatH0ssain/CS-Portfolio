{
  "instructions": [
    "docs/SPEC.md",
    "docs/DESIGN.md",
    "docs/BUILD-PLAN.md",
    "docs/CONTENT-INTAKE.md",
    "docs/LEARNINGS.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.dev.vars": "deny",
      "*.pem": "deny"
    },
    "edit": {
      "*": "allow",
      "content/*": "ask",
      "docs/*": "ask",
      "AGENTS.md": "ask",
      "README.md": "ask",
      "package.json": "ask",
      "astro.config.mjs": "ask",
      "tsconfig.json": "ask",
      "wrangler.jsonc": "ask",
      "src/content.config.ts": "ask",
      "src/lib/content.ts": "ask",
      ".github/*": "ask",
      "scripts/*": "deny",
      ".githooks/*": "deny",
      "mimocode.json": "deny",
      ".gitignore": "ask"
    },
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",

      "npm run *": "allow",
      "node scripts/*": "allow",
      "npx astro check*": "allow",
      "npx astro build*": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "npm ls*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git rev-parse*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "du *": "allow",
      "which *": "allow",

      "git commit*": "ask",
      "git commit --amend*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git branch -*": "ask",
      "git merge*": "ask",
      "git stash*": "ask",
      "git tag*": "ask",
      "git init*": "ask",
      "git remote*": "ask",
      "npm install*": "ask",
      "npm i *": "ask",
      "npm ci*": "ask",
      "npm uninstall*": "ask",
      "gh *": "ask",
      "git branch --show-current": "allow",
      "git branch --list*": "allow",

      "git push*": "deny",
      "git * push*": "deny",
      "git -c*": "deny",
      "* --no-verify*": "deny",
      "git commit -n*": "deny",
      "git commit * -n*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "git config*": "deny",
      "git filter-branch*": "deny",
      "git update-ref*": "deny",
      "git reflog expire*": "deny",
      "rm -rf*": "deny",
      "rm -r *": "deny",
      "rm -fr*": "deny",
      "find * -delete*": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "wrangler *": "deny",
      "npx wrangler*": "deny",
      "gh repo create*": "deny",
      "gh repo delete*": "deny",
      "gh repo edit*": "deny",
      "gh secret*": "deny"
    }
  }
}
